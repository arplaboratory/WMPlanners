    task: str,
    agent: str,
    max_iterations: int | None,
    num_envs: int | None,
    headless: bool,
    use_isaaclab_launcher: bool,
    extra_args: Iterable[str],
) -> List[str]:
    """Construct an Isaac Lab / rloclab training command."""

    if use_isaaclab_launcher:
        command: List[str] = ["./isaaclab.sh", "-p", "scripts/rsl_rl/train.py"]
    else:
        command = [get_python_exe(), "src/rloclab/scripts/rsl_rl/train.py"]

    command.extend(["--task", task, "--agent", agent])
