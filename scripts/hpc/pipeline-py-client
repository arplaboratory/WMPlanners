def launch_dialog_ui(_: argparse.Namespace | None = None) -> None:
    ui = DialogUI()
    choices: List[Tuple[str, str]] = [
        ("install", "Queue install.slurm on HPC"),
        ("download-assets", "Download static assets via assets.yml"),
        ("download-dataset", "Download HF dataset (e.g., lquan9/collect1)"),
        ("pretrain", "Launch pretraining and optional Slurm"),
        ("world-model", "Manage world model (Dataset, Train, Eval)"),
        ("test", "Run tests (pytest) and optional Slurm"),
        ("interactive", "Queue an interactive Slurm job"),
        ("slurm", "Generate a Slurm script for any command"),
        ("monitor", "Monitor queued and running jobs (watch squeue)"),
        ("help", "Show project README.md as help"),
        ("quit", "Exit"),
    ]

    handlers: Dict[str, Callable[[DialogUI], None]] = {
        "install": dialog_install,
        "test": dialog_test,
        "interactive": dialog_interactive,
        "pretrain": dialog_pretrain,
        "download-assets": dialog_download_assets,
        "download-dataset": dialog_download_hf_dataset,
        "slurm": dialog_slurm,
        "monitor": dialog_monitor,
        "help": lambda ui: (
            ui.markdownbox(ROOT / "README.md")
            if (ROOT / "README.md").exists()
            else ui.msgbox("README.md not found.")
        ),
        "quit": lambda ui: None, # Handled by the loop break
    }

    while True:
        try:
            selection = ui.menu("HPC pipeline client", choices)
        except DialogCancelled:
            break

        if selection == "quit":
            break
        else:
            handlers[selection](ui)


def parse_and_run(argv: Sequence[str] | None = None) -> None:
    if argv is None:
        argv = sys.argv[1:]

    parser = build_parser()
    if not argv:
        launch_dialog_ui()
        return

    args = parser.parse_args(list(argv))
    if hasattr(args, "func"):
        args.func(args)
    else:
        launch_dialog_ui()


def main(argv: Sequence[str] | None = None) -> None:
    parse_and_run(argv)


if __name__ == "__main__":
    main()
