def handle_slurm(args: argparse.Namespace) -> None:
    if not args.command:
        raise ValueError("No command provided to embed in the Slurm script. Add arguments after --.")

    output_path = args.output
    if not output_path:
        default_name = "job.slurm"
        for part in reversed(args.command):
            if part.endswith(".py"):
                default_name = f"{Path(part).stem}.slurm"
                break
            elif not part.startswith("-") and part not in ("python", "python3"):
                default_name = f"{part.split('.')[-1]}.slurm"
                break
        output_path = default_name

    generate_slurm_script(
        Path(output_path),
        args.command,
        job_name=args.job_name,
        nodes=args.nodes,
        cpus=args.cpus,
        mem=args.mem,
        time=args.time,
        gpus=args.gpus,
        ext3_path=args.ext3_path,
        sif_path=args.sif_path,
        account=args.account,
        mail_user=args.mail_user,
        mail_type=args.mail_type,
        output_log=args.output_log,
    )

    if args.submit:
        submit_slurm(Path(output_path), dry_run=args.dry_run)


