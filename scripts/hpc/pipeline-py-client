def build_parser() -> argparse.ArgumentParser:
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("--dry-run", action="store_true", help="Print commands without executing them.")

    parser = argparse.ArgumentParser(description=__doc__, parents=[common])
    subparsers = parser.add_subparsers(required=False)

    ui_parser = subparsers.add_parser("ui", parents=[common], help="Launch the dialog-based UI (default).")
    ui_parser.set_defaults(func=launch_dialog_ui)

    install_parser = subparsers.add_parser("install", parents=[common], help="Queue HPC install job via scripts/install.sh.")
    install_parser.add_argument("--host", default="burst", help="HPC login host used for ssh (default: burst).")
    install_parser.add_argument(
        "--pip-command",
        default="pip",
        help="Pip command to run (e.g., pip or pip3).",
    )
    install_parser.add_argument(
        "--remote-project-dir",
        help="Remote project directory containing scripts/hpc/install.slurm (default: ~/REPO_NAME).",
        default=PROJECT_DIR.name
    )
    install_parser.add_argument(
        "--install-slurm",
        default="slurms/install.slurm",
        help="Install Slurm script path relative to project root (default: slurms/install.slurm).",
    )
    install_parser.add_argument(
        "extra_args",
        nargs=argparse.REMAINDER,
        help="Additional arguments forwarded to scripts/install.sh.",
    )
    install_parser.set_defaults(func=handle_install)

    download_parser = subparsers.add_parser("download-assets", parents=[common], help="Download datasets and assets via assets.yml.")
    download_parser.set_defaults(func=handle_download_assets)

