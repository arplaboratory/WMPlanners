def dialog_monitor(ui: DialogUI) -> None:
    user = os.environ.get("USER", "")

    def check_exit() -> bool:
        dr, dw, de = select.select([sys.stdin], [], [], 1.0)
        if dr:
            c = sys.stdin.read(1)
            if c == '\x1b' or c == 'q': # Esc or 'q'
                return True
        return False

    old_settings = termios.tcgetattr(sys.stdin)
    try:
        tty.setcbreak(sys.stdin.fileno())
        while True:
            result = subprocess.run(["squeue", "-u", user], capture_output=True, text=True)
            # Clear screen and move cursor to top-left (ANSI)
            sys.stdout.write("\033[2J\033[H")
            sys.stdout.write(f"=== Monitoring jobs for {user} (Press ESC or 'q' to exit) ===\n\n")
            sys.stdout.write(result.stdout)
            sys.stdout.flush()
            if check_exit():
                break
    except KeyboardInterrupt:
        pass
    finally:
        termios.tcsetattr(sys.stdin, termios.TCSADRAIN, old_settings)
        # Clear one last time to leave a clean state
        sys.stdout.write("\033[2J\033[H")
        sys.stdout.flush()

